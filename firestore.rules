rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function getUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    match /company/{companyId}/{document=**} {
      allow create: if request.auth != null && companyId == getUser().activeCId && request.resource.data.companyId == companyId;
      allow update, delete, read: if request.auth != null && companyId == getUser().activeCId;
      // allow delete: if request.auth != null && companyId == getUser().activeCId && getUser().status == "admin"
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && getUser().status == "admin";
    }
  }
}